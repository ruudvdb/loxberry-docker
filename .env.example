# Copy this file to ".env" and adjust any host port that clashes with
# something else already running on this machine. The number on the LEFT
# is what you change; the number on the RIGHT (in docker-compose.yml) is
# fixed, because it's what LoxBerry uses internally and can't be changed
# without breaking the installer.
#
#   HOST PORT (change me)  ->  CONTAINER PORT (fixed, LoxBerry-internal)

# LoxBerry web interface (HTTP)
LOXBERRY_HTTP_PORT=8880

# LoxBerry web interface (HTTPS)
LOXBERRY_HTTPS_PORT=8843

# SSH access into the container
LOXBERRY_SSH_PORT=2222

# FTP (vsftpd)
LOXBERRY_FTP_PORT=2121

# MQTT broker (Mosquitto)
LOXBERRY_MQTT_PORT=18830

# Samba/SMB file sharing - disabled by default in docker-compose.yml,
# uncomment the matching lines there too if you need it.
LOXBERRY_SAMBA_UDP_137=1137
LOXBERRY_SAMBA_UDP_138=1138
LOXBERRY_SAMBA_TCP_139=1139
LOXBERRY_SAMBA_TCP_445=1445
